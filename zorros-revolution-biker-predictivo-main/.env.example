# Variables del stack de Docker Compose (docker-compose.yml).
# Copiar a ".env" EN LA RAÍZ del repositorio y rellenar los valores reales.
# Este archivo no debe contener secretos: el .env real está en .gitignore.
#
# (Para correr el backend suelto sin Docker, el archivo a usar es
#  backend/.env.example, que apunta a SQLite.)

# ---------- Base de datos (contenedor postgres) ----------
POSTGRES_USER=zorros
POSTGRES_DB=zorros
# Genera una contraseña larga y aleatoria:  openssl rand -hex 24
POSTGRES_PASSWORD=

# ---------- Seguridad ----------
# OBLIGATORIO en producción. Genera con:  openssl rand -hex 32
# Si se deja vacío, compose se niega a levantar (no hay valor por defecto).
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Dominio real. Nunca "*" en producción.
CORS_ORIGINS=https://prediccionzrb.duckdns.org

# ---------- Recursos ----------
# El VPS tiene 1 núcleo y memoria compartida con otros proyectos; cada worker
# carga pandas + scikit-learn (~250-350 MB). No subir sin medir antes.
GUNICORN_WORKERS=2

# ---------- Reglas de negocio ----------
LEAD_TIME_DEFAULT_DIAS=60
DIAS_SEGURIDAD_STOCK=10
