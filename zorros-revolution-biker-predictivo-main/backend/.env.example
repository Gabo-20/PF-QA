# Copia este archivo a ".env" en esta misma carpeta (backend/) y ajusta los valores.

# ---------- Base de datos ----------
# Desarrollo local (SQLite, no requiere instalar MySQL):
DATABASE_URL=sqlite:///./zorros.db

# Producción en Hostinger (MySQL) - reemplaza con tus credenciales reales de hPanel:
# DATABASE_URL=mysql+pymysql://usuario_mysql:password_mysql@localhost/nombre_basedatos

# ---------- Seguridad ----------
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria-en-produccion
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ---------- Reglas de negocio ----------
# Días promedio de envío desde China usados como default para productos nuevos.
LEAD_TIME_DEFAULT_DIAS=60
DIAS_SEGURIDAD_STOCK=10

# ---------- CORS ----------
# Orígenes permitidos separados por coma. Usa "*" solo en desarrollo.
# En producción, usa el dominio real, ej: https://www.zorrosrevolution.com
CORS_ORIGINS=*
